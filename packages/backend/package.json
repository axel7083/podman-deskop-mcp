    "lint:fix": "eslint . --fix",
    "watch": "vite build --watch --mode development"
  },
  "devDependencies": {
    "@podman-desktop/api": "^1.30.5",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.0",
