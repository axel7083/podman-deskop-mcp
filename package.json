{
  "name": "helloworld",
  "displayName": "Hello World",
  "description": "Hello World template for using webview",
  "version": "1.4.0-next",
  "icon": "icon.png",
  "publisher": "yourusername",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "concurrently \"pnpm --filter ./packages/frontend build\" \"pnpm --filter ./packages/backend build\"",
    "watch": "concurrently \"pnpm --filter ./packages/frontend watch\" \"pnpm --filter ./packages/backend watch\"",
    "format:check": "prettier --check \"**/src/**/*.{ts,svelte}\"",
    "format:fix": "prettier --write \"**/src/**/*.{ts,svelte}\"",
    "lint:check": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "svelte:check": "svelte-check",
    "test:backend": "vitest run -r packages/backend --passWithNoTests --coverage",
    "test:frontend": "vitest -c packages/frontend/vite.config.ts run packages/frontend --passWithNoTests --coverage",
    "test:shared": "vitest run -r packages/shared --passWithNoTests --coverage",
    "test": "pnpm test:backend && pnpm test:shared && pnpm test:frontend",
    "typecheck:shared": "tsc --noEmit --project packages/shared",
    "typecheck:frontend": "tsc --noEmit --project packages/frontend",
    "typecheck:backend": "tsc --noEmit --project packages/backend",
    "typecheck": "pnpm typecheck:shared && pnpm typecheck:frontend && pnpm typecheck:backend"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@podman-desktop/eslint-config": "0.1.0",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.7",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.3.3",
    "prettier-plugin-svelte": "^3.4.0",
    "svelte": "^5.55.7",
    "svelte-check": "^4.7.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "8.3.5",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "js-yaml": "^4.3.2"
  },
  "packageManager": "pnpm@12.8.1+sha512.f64ba907507f5ceafe06c8d38e6052d0179444580ec1279ddd5bfc11cb48aa8a2644b66598e07e761da84872a9fc57d5f902b87fa49d024198d558612aabbe45"
}
